{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "voyago-shadows",
  "description": "VOYAGO Design System - Shadow tokens for elevation system",
  "version": "1.0.0",
  "modes": {
    "light": {
      "elevation": {
        "0": { "value": "none", "description": "No shadow" },
        "1": { "value": "0 1px 2px 0 rgb(0 0 0 / 0.05)", "description": "Subtle (cards, dropdowns)" },
        "2": { "value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)", "description": "Low (default card, input focus)" },
        "3": { "value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)", "description": "Medium (hovered card, modal)" },
        "4": { "value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)", "description": "High (dialog, popover)" },
        "5": { "value": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)", "description": "Maximum (full-screen modal, drawer)" }
      },
      "colored": {
        "primary": { "value": "0 0 0 3px rgb(59 130 246 / 0.4)", "description": "Primary focus ring" },
        "secondary": { "value": "0 0 0 3px rgb(34 197 94 / 0.4)", "description": "Secondary focus ring" },
        "error": { "value": "0 0 0 3px rgb(220 38 38 / 0.4)", "description": "Error focus ring" },
        "success": { "value": "0 0 0 3px rgb(22 163 74 / 0.4)", "description": "Success focus ring" }
      },
      "inset": {
        "input": { "value": "inset 0 1px 2px 0 rgb(0 0 0 / 0.05)", "description": "Input inset shadow" },
        "inputFocus": { "value": "inset 0 1px 2px 0 rgb(0 0 0 / 0.05), 0 0 0 3px rgb(59 130 246 / 0.4)", "description": "Input focus inset" }
      }
    },
    "dark": {
      "elevation": {
        "0": { "value": "none", "description": "No shadow" },
        "1": { "value": "0 1px 2px 0 rgb(0 0 0 / 0.3)", "description": "Subtle" },
        "2": { "value": "0 1px 3px 0 rgb(0 0 0 / 0.4), 0 1px 2px -1px rgb(0 0 0 / 0.4)", "description": "Low" },
        "3": { "value": "0 4px 6px -1px rgb(0 0 0 / 0.4), 0 2px 4px -2px rgb(0 0 0 / 0.3)", "description": "Medium" },
        "4": { "value": "0 10px 15px -3px rgb(0 0 0 / 0.4), 0 4px 6px -4px rgb(0 0 0 / 0.3)", "description": "High" },
        "5": { "value": "0 20px 25px -5px rgb(0 0 0 / 0.4), 0 8px 10px -6px rgb(0 0 0 / 0.3)", "description": "Maximum" }
      },
      "colored": {
        "primary": { "value": "0 0 0 3px rgb(96 165 250 / 0.4)", "description": "Primary focus ring" },
        "secondary": { "value": "0 0 0 3px rgb(74 222 128 / 0.4)", "description": "Secondary focus ring" },
        "error": { "value": "0 0 0 3px rgb(248 113 113 / 0.4)", "description": "Error focus ring" },
        "success": { "value": "0 0 0 3px rgb(74 222 128 / 0.4)", "description": "Success focus ring" }
      },
      "inset": {
        "input": { "value": "inset 0 1px 2px 0 rgb(0 0 0 / 0.3)", "description": "Input inset shadow" },
        "inputFocus": { "value": "inset 0 1px 2px 0 rgb(0 0 0 / 0.3), 0 0 0 3px rgb(96 165 250 / 0.4)", "description": "Input focus inset" }
      }
    }
  },
  "tailwindConfig": {
    "boxShadow": {
      "none": "none",
      "elev-1": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "elev-2": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
      "elev-3": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
      "elev-4": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
      "elev-5": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
      "focus-primary": "0 0 0 3px rgb(59 130 246 / 0.4)",
      "focus-secondary": "0 0 0 3px rgb(34 197 94 / 0.4)",
      "focus-error": "0 0 0 3px rgb(220 38 38 / 0.4)",
      "inset-input": "inset 0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "inset-input-focus": "inset 0 1px 2px 0 rgb(0 0 0 / 0.05), 0 0 0 3px rgb(59 130 246 / 0.4)"
    }
  },
  "cssVariables": {
    "--shadow-elev-1": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "--shadow-elev-2": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "--shadow-elev-3": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "--shadow-elev-4": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "--shadow-elev-5": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
    "--shadow-focus-primary": "0 0 0 3px rgb(59 130 246 / 0.4)",
    "--shadow-focus-secondary": "0 0 0 3px rgb(34 197 94 / 0.4)",
    "--shadow-focus-error": "0 0 0 3px rgb(220 38 38 / 0.4)",
    "--shadow-inset-input": "inset 0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "--shadow-inset-input-focus": "inset 0 1px 2px 0 rgb(0 0 0 / 0.05), 0 0 0 3px rgb(59 130 246 / 0.4)"
  }
}