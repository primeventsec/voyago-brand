{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "voyago-spacing",
  "description": "VOYAGO Design System - Spacing tokens (4px base scale) with fluid clamp for responsive gaps",
  "version": "1.0.0",
  "baseUnit": 4,
  "scale": {
    "0": { "value": "0", "rem": "0", "px": 0, "description": "No spacing" },
    "1": { "value": "0.25rem", "rem": "0.25rem", "px": 4, "description": "Micro spacing (icon gaps, inline)" },
    "2": { "value": "0.5rem", "rem": "0.5rem", "px": 8, "description": "Tight spacing (form fields, button padding)" },
    "3": { "value": "0.75rem", "rem": "0.75rem", "px": 12, "description": "Small spacing (card padding, list items)" },
    "4": { "value": "1rem", "rem": "1rem", "px": 16, "description": "Base spacing (default card, container padding)" },
    "5": { "value": "1.25rem", "rem": "1.25rem", "px": 20, "description": "Medium spacing (section gap, form groups)" },
    "6": { "value": "1.5rem", "rem": "1.5rem", "px": 24, "description": "Large spacing (page sections, sidebar)" },
    "7": { "value": "1.75rem", "rem": "1.75rem", "px": 28, "description": "XL spacing (major sections)" },
    "8": { "value": "2rem", "rem": "2rem", "px": 32, "description": "2XL spacing (page margins, hero)" },
    "10": { "value": "2.5rem", "rem": "2.5rem", "px": 40, "description": "3XL spacing (landing sections)" },
    "12": { "value": "3rem", "rem": "3rem", "px": 48, "description": "4XL spacing (major layout)" },
    "16": { "value": "4rem", "rem": "4rem", "px": 64, "description": "5XL spacing (hero, full bleed)" },
    "20": { "value": "5rem", "rem": "5rem", "px": 80, "description": "6XL spacing (extra large)" },
    "24": { "value": "6rem", "rem": "6rem", "px": 96, "description": "7XL spacing (maximum)" }
  },
  "fluid": {
    "gap-sm": { "clamp": "clamp(0.5rem, 1vw + 0.25rem, 1rem)", "description": "Small responsive gap" },
    "gap-md": { "clamp": "clamp(1rem, 2vw + 0.5rem, 1.5rem)", "description": "Medium responsive gap" },
    "gap-lg": { "clamp": "clamp(1.5rem, 3vw + 0.5rem, 2.5rem)", "description": "Large responsive gap" },
    "gap-xl": { "clamp": "clamp(2rem, 4vw + 0.5rem, 4rem)", "description": "XL responsive gap" },
    "section-padding": { "clamp": "clamp(1.5rem, 3vw + 1rem, 4rem)", "description": "Section vertical padding" },
    "container-padding": { "clamp": "clamp(1rem, 2vw + 0.5rem, 2rem)", "description": "Container horizontal padding" }
  },
  "semantic": {
    "inline": { "value": "{1}", "description": "Inline element gap (icon + text)" },
    "stack": { "value": "{2}", "description": "Vertical stack gap (form fields)" },
    "group": { "value": "{4}", "description": "Related group gap (card content)" },
    "section": { "value": "{6}", "description": "Section gap (unrelated content)" },
    "page": { "value": "{8}", "description": "Page level spacing" },
    "layout": { "value": "{10}", "description": "Major layout spacing" },
    "container": { "value": "{4}", "description": "Container padding" },
    "card": { "value": "{4}", "description": "Card internal padding" },
    "button": { "value": "{2}", "description": "Button padding (horizontal)" },
    "buttonVertical": { "value": "{1}", "description": "Button padding (vertical)" },
    "input": { "value": "{2}", "description": "Input padding" },
    "table": { "value": "{3}", "description": "Table cell padding" },
    "modal": { "value": "{6}", "description": "Modal padding" },
    "dropdown": { "value": "{1}", "description": "Dropdown item padding" },
    "tooltip": { "value": "{2}", "description": "Tooltip padding" },
    "avatar": { "value": "{1}", "description": "Avatar gap" },
    "badge": { "value": "{1}", "description": "Badge horizontal padding" },
    "sidebar": { "value": "{6}", "description": "Sidebar item padding" },
    "navbar": { "value": "{4}", "description": "Navbar height padding" }
  },
  "tailwindConfig": {
    "spacing": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "7": "1.75rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem",
      "fluid-sm": "clamp(0.5rem, 1vw + 0.25rem, 1rem)",
      "fluid-md": "clamp(1rem, 2vw + 0.5rem, 1.5rem)",
      "fluid-lg": "clamp(1.5rem, 3vw + 0.5rem, 2.5rem)",
      "fluid-xl": "clamp(2rem, 4vw + 0.5rem, 4rem)",
      "section": "clamp(1.5rem, 3vw + 1rem, 4rem)",
      "container": "clamp(1rem, 2vw + 0.5rem, 2rem)"
    }
  },
  "cssVariables": {
    "--space-0": "0",
    "--space-1": "0.25rem",
    "--space-2": "0.5rem",
    "--space-3": "0.75rem",
    "--space-4": "1rem",
    "--space-5": "1.25rem",
    "--space-6": "1.5rem",
    "--space-7": "1.75rem",
    "--space-8": "2rem",
    "--space-10": "2.5rem",
    "--space-12": "3rem",
    "--space-16": "4rem",
    "--space-20": "5rem",
    "--space-24": "6rem",
    "--space-fluid-sm": "clamp(0.5rem, 1vw + 0.25rem, 1rem)",
    "--space-fluid-md": "clamp(1rem, 2vw + 0.5rem, 1.5rem)",
    "--space-fluid-lg": "clamp(1.5rem, 3vw + 0.5rem, 2.5rem)",
    "--space-fluid-xl": "clamp(2rem, 4vw + 0.5rem, 4rem)",
    "--space-section": "clamp(1.5rem, 3vw + 1rem, 4rem)",
    "--space-container": "clamp(1rem, 2vw + 0.5rem, 2rem)"
  }
}